# Copy to .env.local and fill in. Never commit real credentials.
DB_SERVER=your-sql-server-host
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# Secret used to sign login sessions (min 32 chars). Generate with: openssl rand -base64 48
SESSION_SECRET=
